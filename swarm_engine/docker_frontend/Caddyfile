{
    # Global options
    email roachpestanalyzer@gmail.com
}

pestanalyzer.duckdns.org {
    # Set root directory for static files
    root * /usr/share/caddy
    
    # Enable static file server
    file_server
    
    # Handle SPA routing (fallback to index.html)
    try_files {path} /index.html

    # Optional: Enable compression
    encode gzip

    # Configure ZeroSSL as the CA
    tls {
        ca https://acme.zerossl.com/v2/DV90
    }

    # Proxy API requests to the swarm-engine backend
    handle /api/* {
        reverse_proxy swarm-engine:8001
    }

    # Proxy documentation if needed (optional)
    handle /docs {
        reverse_proxy swarm-engine:8001
    }
    handle /openapi.json {
        reverse_proxy swarm-engine:8001
    }
}
