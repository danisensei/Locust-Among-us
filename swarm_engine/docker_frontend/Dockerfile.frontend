# ============================================================================
# Frontend Dockerfile — Build Vite + serve with nginx
# ============================================================================

# Stage 1: Build
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies first (layer caching)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source and build
COPY . .

# Build args → baked into the Vite bundle at build time
ARG VITE_API_URL
ARG VITE_SWARM_API_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SWARM_API_URL=$VITE_SWARM_API_URL

RUN npm run build

# Stage 2: Serve with Caddy (Automatic HTTPS + SPA + Reverse Proxy)
FROM caddy:alpine

# Copy built assets
COPY --from=build /app/dist /usr/share/caddy

# Create Caddyfile
# This configures Caddy to:
# 1. Automatically fetch a ZeroSSL/Let's Encrypt cert for the domain
# 2. Proxy all /api/* requests to the FastAPI backend (swarm-engine:8001)
# 3. Serve the static Vite frontend for all other routes with SPA fallback
RUN echo "roachpestanalyzer.duckdns.org {" > /etc/caddy/Caddyfile && \
    echo "    root * /usr/share/caddy" >> /etc/caddy/Caddyfile && \
    echo "    encode gzip" >> /etc/caddy/Caddyfile && \
    echo "    reverse_proxy /api/* swarm-engine:8001" >> /etc/caddy/Caddyfile && \
    echo "    reverse_proxy /auth/* swarm-engine:8001" >> /etc/caddy/Caddyfile && \
    echo "    try_files {path} /index.html" >> /etc/caddy/Caddyfile && \
    echo "    file_server" >> /etc/caddy/Caddyfile && \
    echo "}" >> /etc/caddy/Caddyfile

EXPOSE 80 443

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
