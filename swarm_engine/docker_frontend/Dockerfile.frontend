# ============================================================================
# Frontend Dockerfile — Build Vite + serve with nginx
# ============================================================================

# Stage 1: Build
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies first (layer caching)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source and build
COPY . .

# Build args → baked into the Vite bundle at build time
ARG VITE_API_URL
ARG VITE_SWARM_API_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SWARM_API_URL=$VITE_SWARM_API_URL

RUN npm run build

# Stage 2: Serve with Caddy
FROM caddy:2-alpine

# Copy built assets to Caddy's default static file location
COPY --from=build /app/dist /usr/share/caddy

# Copy Caddyfile config
COPY ./swarm_engine/docker_frontend/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
