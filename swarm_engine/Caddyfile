# Change this to your actual domain name!
roachpestanalyzer.duckdns.org {
    # 1. Route all /api/ traffic to the Python backend
    # We use 'handle' so the /api prefix is preserved and passed to FastAPI
    handle /api/* {
        reverse_proxy swarm-engine:8001
    }

    # 2. Route everything else to the React frontend
    handle {
        reverse_proxy frontend:80
    }
}
